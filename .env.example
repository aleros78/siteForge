# ─── SiteForge Environment ───────────────────────────────────────────────────

# Application
APP_NAME=SiteForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://siteforge.localhost
APP_DOMAIN=siteforge.localhost

# Database
DB_DATABASE=siteforge
DB_USERNAME=siteforge
DB_PASSWORD=siteforge_pass
DB_ROOT_PASSWORD=siteforge_root_secret

# Queue
QUEUE_CONNECTION=database

# Redis (opzionale, per future espansioni)
REDIS_PASSWORD=null

# SiteForge Paths
PROJECTS_BASE_PATH=/opt/siteforge/projects
TEMPLATES_BASE_PATH=/opt/siteforge/templates

# Backup
BACKUP_DISK=local
BACKUP_PATH=/opt/siteforge/backups

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error
